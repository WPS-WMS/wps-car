# Variáveis para API no Render (painel Environment) — referência QA
NODE_ENV=production
PORT=10000
API_PREFIX=api/v1

# Neon — duas URLs (painel Neon → Connection details):
# DATABASE_URL = pooled (-pooler) — API em produção
# DIRECT_DATABASE_URL = direct (sem -pooler) — prisma migrate deploy
# Ex. pooled:  postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=15
# Ex. direct:  postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=30
# connect_timeout ajuda quando o Neon está “dormindo” (erro P1001 no Render).
DATABASE_URL=
DIRECT_DATABASE_URL=

# Origens do frontend (Firebase). Várias URLs separadas por vírgula:
# https://seu-projeto.web.app,https://seu-projeto.firebaseapp.com
CORS_ORIGIN=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Import de veículos (escolha um)
# API local apontando ao Neon QA:
IMPORT_API_URL=http://localhost:3001/api/v1
# Ou API já publicada no Render:
# IMPORT_API_URL=https://SUA-API-QA.onrender.com/api/v1
