# Variáveis para API no Render (painel Environment) — referência QA
NODE_ENV=production
PORT=10000
API_PREFIX=api/v1

# Neon — use connection string com SSL (pooler recomendado)
# Ex.: postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Origens do frontend (Firebase). Várias URLs separadas por vírgula:
# https://seu-projeto.web.app,https://seu-projeto.firebaseapp.com
CORS_ORIGIN=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
