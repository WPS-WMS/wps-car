{
  "name": "@wps-car/api",
  "version": "0.1.0",
  "private": true,
  "description": "WPS Car — API NestJS",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "cross-env ENV_PROFILE=local nest start --watch",
    "start:dev:qa": "cross-env ENV_PROFILE=qa nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:render": "bash scripts/render-start.sh",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "cross-env DOTENV_CONFIG_PATH=.env.local prisma migrate deploy",
    "prisma:migrate:deploy:qa": "cross-env DOTENV_CONFIG_PATH=.env.qa prisma migrate deploy",
    "db:unlock": "prisma db execute --file scripts/release-migration-lock.sql --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio",
    "prisma:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:seed": "cross-env DOTENV_CONFIG_PATH=.env.local prisma db seed",
    "db:seed:qa": "cross-env DOTENV_CONFIG_PATH=.env.qa prisma db seed",
    "db:seed:beta": "ts-node --project tsconfig.scripts.json scripts/seed-beta-tenant.ts",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "test:e2e:vehicles": "jest --config ./test/jest-e2e.json --runInBand vehicles-create",
    "import:vehicles": "ts-node --project tsconfig.scripts.json scripts/bulk-import-vehicles.ts",
    "import:vehicles:alpha": "ts-node --project tsconfig.scripts.json scripts/bulk-import-vehicles.ts -- --file=../../scripts/vehicles-import-alpha.example.csv --tenant=alpha",
    "import:vehicles:beta": "ts-node --project tsconfig.scripts.json scripts/bulk-import-vehicles.ts -- --file=../../scripts/vehicles-import-beta.example.csv --tenant=beta",
    "import:vehicles:demo": "cross-env ENV_PROFILE=local ts-node --project tsconfig.scripts.json scripts/bulk-import-vehicles.ts -- --file=../../scripts/vehicles-import-demo.csv --tenant=all",
    "import:vehicles:demo:qa": "cross-env ENV_PROFILE=qa ts-node --project tsconfig.scripts.json scripts/bulk-import-vehicles.ts -- --file=../../scripts/vehicles-import-demo.csv --tenant=all"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.scripts.json prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.8.2",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.78.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "exceljs": "^4.4.0",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "nodemailer": "^8.0.11",
    "otplib": "^13.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfmake": "^0.3.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.3",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.15.29",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfmake": "^0.3.3",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prisma": "^6.8.2",
    "supertest": "^7.1.0",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
