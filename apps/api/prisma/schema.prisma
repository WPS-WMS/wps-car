// Filial vinculada ao tenant (matriz)
model TenantBranch {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  address   String?
  phone     String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0) @map("sort_order")
