  tenantId  String   @map("tenant_id")
  code      String // welcome, sale_completed, etc.
  subject   String
  bodyHtml  String   @map("body_html")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@map("config_email_templates")
}

// =============================================================================
// ANEXOS (upload local → S3 futuro)
// =============================================================================

model Attachment {
  id         String                    @id @default(uuid())
  tenantId   String                    @map("tenant_id")
  entityType AttachmentEntityType      @map("entity_type")
  entityId   String                    @map("entity_id")
  fileName   String                    @map("file_name")
  filePath   String                    @map("file_path")
  mimeType     String?                   @map("mime_type")
  sizeBytes    Int?                      @map("size_bytes")
  documentType VehicleDocumentType?      @map("document_type")
  storage      AttachmentStorageProvider @default(LOCAL)
  createdAt    DateTime                  @default(now()) @map("created_at")

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, entityType, entityId, documentType])
  @@map("attachments")
}

// =============================================================================
// COMPRA INTELIGENTE — histórico de consultas FIPE/placa
// =============================================================================

model PurchaseIntelligenceQuery {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  licensePlate         String   @map("license_plate")
  fipeValue            Decimal? @map("fipe_value") @db.Decimal(14, 2)
  desiredMarginPercent Decimal? @map("desired_margin_percent") @db.Decimal(8, 4)
  estimatedCosts       Decimal? @map("estimated_costs") @db.Decimal(14, 2)
  maxPurchaseValue     Decimal? @map("max_purchase_value") @db.Decimal(14, 2)
  rawResponse          Json?    @map("raw_response")
  userId               String?  @map("user_id")
  createdAt            DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, licensePlate, createdAt])
  @@map("purchase_intelligence_queries")
}

// =============================================================================
// PRECIFICAÇÃO INTELIGENTE — histórico de sugestões de preço de venda
// =============================================================================

model PricingIntelligenceQuery {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  vehicleId          String   @map("vehicle_id")
  userId             String?  @map("user_id")
  fipeValue          Decimal? @map("fipe_value") @db.Decimal(14, 2)
  marketReference    Decimal? @map("market_reference") @db.Decimal(14, 2)
  minMarginPercent   Decimal  @map("min_margin_percent") @db.Decimal(8, 4)
  conservativePrice  Decimal  @map("conservative_price") @db.Decimal(14, 2)
  competitivePrice   Decimal  @map("competitive_price") @db.Decimal(14, 2)
  aggressivePrice    Decimal  @map("aggressive_price") @db.Decimal(14, 2)
  idealListingPrice  Decimal  @map("ideal_listing_price") @db.Decimal(14, 2)
  minimumRecommended Decimal  @map("minimum_recommended") @db.Decimal(14, 2)
  rawResponse        Json?    @map("raw_response")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([tenantId, vehicleId, createdAt])
  @@map("pricing_intelligence_queries")
}

// =============================================================================
// RELATÓRIOS — exportações assíncronas
// =============================================================================

model ExportJob {
  id            String          @id @default(uuid())
  tenantId      String          @map("tenant_id")
  requestedById String          @map("requested_by_id")
  type          ExportJobType
  format        String
  status        ExportJobStatus @default(PENDING)
  params        Json
  filePath      String?         @map("file_path")
  fileName      String?         @map("file_name")
  mimeType      String?         @map("mime_type")
  errorMessage  String?         @map("error_message")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  completedAt   DateTime?       @map("completed_at")

  tenant      Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedBy User   @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, requestedById])
  @@map("export_jobs")
}

model AuditLog {
  id         String      @id @default(uuid())
  tenantId   String?     @map("tenant_id")
  userId     String?     @map("user_id")
  action     AuditAction
  entityType String?     @map("entity_type")
  entityId   String?     @map("entity_id")
  metadata   Json?
  ipAddress  String?     @map("ip_address")
  userAgent  String?     @map("user_agent")
  createdAt  DateTime    @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
