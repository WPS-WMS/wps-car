// =============================================================================
// WPS Car — Modelagem inicial (SaaS multi-tenant para revendas de veículos)
// Fase 1: apenas schema. NestJS, services e frontend virão nos próximos módulos.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations usam conexão direta (Neon pooler não suporta advisory lock do Prisma)
  directUrl = env("DIRECT_DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums — Tenant & Auth
// -----------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TRIAL
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum UserRole {
  MODERATOR // plataforma (tenantId nulo)
  ADMIN
  MANAGER
  SELLER
}

// -----------------------------------------------------------------------------
// Enums — Veículos & Estoque
// -----------------------------------------------------------------------------

enum VehicleType {
  CAR
  MOTORCYCLE
  TRUCK
  UTILITY
  PRODUCT // Produto (acessório, peça, bem não veicular)
  OTHER
}

enum VehicleStatus {
  IN_STOCK // Em estoque
  RESERVED // Reservado
  SOLD // Vendido
  IN_PREPARATION // Em preparação
  IN_MAINTENANCE // Em manutenção
  UNAVAILABLE // Indisponível
}

enum FuelType {
  GASOLINE
  ETHANOL
  FLEX
  DIESEL
  ELECTRIC
  HYBRID
  GNV
  OTHER
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  CVT
  AUTOMATED_MANUAL
  OTHER
}

enum VehicleCategory {
  HATCH
  SEDAN
  SUV
  PICKUP
  VAN
  COUPE
  WAGON
  OTHER
}

enum StockMovementType {
  ENTRY // Entrada
  EXIT // Saída
  ADJUSTMENT // Ajuste
  RESERVATION // Reserva
  RELEASE // Liberação de reserva
}

enum ExportJobType {
  STOCK
  SALES
  SUMMARY
}

enum ExportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AuditAction {
  AUTH_LOGIN_SUCCESS
  AUTH_LOGIN_FAILED
  AUTH_LOGOUT
  AUTH_LOGOUT_ALL
  AUTH_PASSWORD_RESET
  AUTH_REFRESH_REUSE
  AUTH_2FA_ENABLED
  AUTH_2FA_DISABLED
  AUTH_2FA_FAILED
  USER_PASSWORD_RESET
  USER_PERMISSIONS_UPDATED
  VEHICLE_DELETED
  SALE_CREATED
}

// -----------------------------------------------------------------------------
// Enums — Pessoas (Cliente / Fornecedor)
// -----------------------------------------------------------------------------

enum PersonType {
  INDIVIDUAL // Pessoa física
  COMPANY // Pessoa jurídica
}

enum SupplierCategory {
  INDIVIDUAL
  COMPANY
  AUCTION // Leilão
  DEALERSHIP // Revenda
  INSURANCE // Seguradora
  BANK // Banco
  PRIVATE // Particular
}

enum CustomerType {
  BUYER
  SELLER
  BOTH
}

// -----------------------------------------------------------------------------
// Enums — Financeiro, Custos, Vendas
// -----------------------------------------------------------------------------

enum VehicleCostType {
  PAINTING
  MECHANICS
  BODYWORK
  SANITIZATION
  DOCUMENTATION
  DISPATCHER
  TRANSPORT
  TOWING
  ADVERTISING
  COMMISSION
  WASHING
  REVISION
  OTHER
}

enum SaleStatus {
  NEGOTIATION // Em negociação
  SOLD // Vendido
  CANCELLED // Cancelado
  AWAITING_PAYMENT // Aguardando pagamento
  COMPLETED // Finalizado
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  PIX
  CREDIT_CARD
  DEBIT_CARD
  FINANCING
  CHECK
  TRADE_IN
  OTHER
}

enum CommissionRuleType {
  SALE_PERCENTAGE // Percentual sobre venda
  PROFIT_PERCENTAGE // Percentual sobre lucro
  FIXED_AMOUNT // Valor fixo
  CUSTOM_PER_VEHICLE // Personalizado por veículo
}

enum OpportunityStatus {
  OPEN
  IN_PROGRESS
  WON
  LOST
  CANCELLED
}

enum AttachmentEntityType {
  VEHICLE
  VEHICLE_COST
  SALE
  CUSTOMER
  SUPPLIER
}

enum VehicleDocumentType {
  CRLV
  INVOICE
  PURCHASE_CONTRACT
  SALE_CONTRACT
  CAUTELAR_REPORT
  OTHER
}

enum LeadSource {
  WHATSAPP
  PHONE
  STORE
  WEBSITE
  REFERRAL
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATION
  WON
  LOST
}

enum ContactChannel {
  PHONE
  WHATSAPP
  EMAIL
  VISIT
  OTHER
}

enum ReminderStatus {
  PENDING
  DONE
  CANCELLED
}

enum AttachmentStorageProvider {
  LOCAL
  S3
}

// -----------------------------------------------------------------------------
// Base auditável (campos repetidos via convenção — Prisma não suporta herança)
// Todas as entidades de negócio do tenant incluem tenantId + auditoria.
// -----------------------------------------------------------------------------

// =============================================================================
// TENANT (Empresa)
// =============================================================================

model Tenant {
  id        String           @id @default(uuid())
  name      String
  cnpj      String           @unique
  email     String
  phone     String?
  status    TenantStatus     @default(TRIAL)
  plan      SubscriptionPlan @default(STARTER)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  users            User[]
  vehicles         Vehicle[]
  customers        Customer[]
  suppliers        Supplier[]
  sales            Sale[]
  opportunities    Opportunity[]
  commissionRules  CommissionRule[]
  sellerCommissionRules SellerCommissionRule[]
  tenantSettings   TenantSetting[]
  stockMovements   StockMovement[]
  vehicleCosts     VehicleCost[]
  refreshTokens    RefreshToken[]
  configVehicleTypes   ConfigVehicleType[]
  configCostTypes      ConfigCostType[]
  configPaymentMethods ConfigPaymentMethod[]
  configStatuses       ConfigStatus[]
  configEmailTemplates ConfigEmailTemplate[]
  branches             TenantBranch[]
  exportJobs           ExportJob[]
  auditLogs            AuditLog[]
  leads                Lead[]

  @@map("tenants")
}

// =============================================================================
// AUTH — Usuários, tokens, RBAC
// =============================================================================

model User {
  id           String    @id @default(uuid())
  tenantId     String?   @map("tenant_id") // nulo apenas para MODERATOR (plataforma)
  name         String
  email        String
  passwordHash String    @map("password_hash")
  phone        String?   @map("phone")
  address      String?   @map("address")
  role         UserRole
  active       Boolean   @default(true)
  deactivatedAt DateTime? @map("deactivated_at")
  deactivationReason String? @map("deactivation_reason")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdById  String?   @map("created_by_id")
  updatedById  String?   @map("updated_by_id")
  branchId     String?   @map("branch_id") // null = matriz (tenant)
  tokenVersion Int       @default(0) @map("token_version")
  totpSecret   String?   @map("totp_secret")
  totpEnabled  Boolean   @default(false) @map("totp_enabled")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch TenantBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  createdBy User?  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?  @relation("UserUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdUsers User[] @relation("UserCreatedBy")
  updatedUsers User[] @relation("UserUpdatedBy")

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  rolePermissions     UserPermission[] // overrides por usuário (opcional)
  assignedCustomers   Customer[]       @relation("CustomerAssignedSeller")
  salesAsSeller       Sale[]           @relation("SaleSeller")
  opportunities       Opportunity[]
  assignedLeads       Lead[]               @relation("LeadAssignedSeller")
  leadContacts        LeadContact[]
  sellerReminders     SellerReminder[]
  stockMovements      StockMovement[]
  vehicleCostsResponsible VehicleCost[] @relation("VehicleCostResponsible")
  vehicleCostsCreated     VehicleCost[] @relation("VehicleCostCreatedBy")
  vehiclesCreated       Vehicle[]          @relation("VehicleCreatedBy")
  vehiclesUpdated       Vehicle[]          @relation("VehicleUpdatedBy")
  vehicleFinancialsSold VehicleFinancial[] @relation("VehicleFinancialSeller")
  commissionRule        SellerCommissionRule?
  exportJobsRequested   ExportJob[]
  auditLogs             AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tenantId  String?  @map("tenant_id")
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  familyId  String?  @map("family_id")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

/// Permissões granulares por módulo (RBAC complementar ao role)
model Permission {
  id          String @id @default(uuid())
  code        String @unique // ex: vehicles:read, sales:create
  module      String // ex: vehicles, sales, financial
  description String?

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid())
  role         UserRole
  permissionId String   @map("permission_id")

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@map("role_permissions")
}

/// Override de permissão por usuário (além do perfil)
model UserPermission {
  id           String  @id @default(uuid())
  userId       String  @map("user_id")
  permissionId String  @map("permission_id")
  granted      Boolean @default(true)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@map("user_permissions")
}

// =============================================================================
// VEÍCULOS
// =============================================================================

model Vehicle {
  id              String           @id @default(uuid())
  tenantId        String           @map("tenant_id")
  type            VehicleType
  brand           String
  model           String
  version         String?
  manufactureYear Int              @map("manufacture_year")
  modelYear       Int              @map("model_year")
  licensePlate    String?          @map("license_plate")
  renavam         String?
  chassis         String?
  color           String?
  mileage         Int?
  fuel            FuelType?
  transmission    TransmissionType?
  doors           Int?
  category        VehicleCategory?
  status          VehicleStatus    @default(IN_STOCK)
  notes           String?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  createdById     String?          @map("created_by_id")
  updatedById     String?          @map("updated_by_id")
  branchId        String?          @map("branch_id")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch    TenantBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBy User?  @relation("VehicleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User?  @relation("VehicleUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  photos          VehiclePhoto[]
  financial       VehicleFinancial?
  costs           VehicleCost[]
  stockMovements  StockMovement[]
  sales           Sale[]
  opportunities   Opportunity[]
  leadInterests   LeadVehicleInterest[]
  commissionOverrides VehicleCommissionOverride[]

  @@unique([tenantId, licensePlate])
  @@unique([tenantId, chassis])
  @@index([tenantId, status])
  @@index([tenantId, brand, model])
  @@index([tenantId, branchId])
  @@map("vehicles")
}

model VehiclePhoto {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  vehicleId String   @map("vehicle_id")
  fileName  String   @map("file_name")
  filePath  String   @map("file_path")
  thumbnailPath String? @map("thumbnail_path")
  mimeType  String?  @map("mime_type")
  sizeBytes Int?     @map("size_bytes")
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  storage   AttachmentStorageProvider @default(LOCAL)
  createdAt DateTime @default(now()) @map("created_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([tenantId, vehicleId])
  @@map("vehicle_photos")
}

// =============================================================================
// FINANCEIRO POR VEÍCULO (+ campos calculados persistidos para relatórios)
// =============================================================================

model VehicleFinancial {
  id                     String    @id @default(uuid())
  tenantId               String    @map("tenant_id")
  vehicleId              String    @unique @map("vehicle_id")
  purchaseValue         Decimal   @map("purchase_value") @db.Decimal(14, 2)
  purchaseDate          DateTime? @map("purchase_date")
  supplierId            String?   @map("supplier_id")
  fipeValue             Decimal?  @map("fipe_value") @db.Decimal(14, 2)
  suggestedPurchaseValue Decimal? @map("suggested_purchase_value") @db.Decimal(14, 2)
  listedValue           Decimal?  @map("listed_value") @db.Decimal(14, 2) // Valor anunciado
  minimumValue          Decimal?  @map("minimum_value") @db.Decimal(14, 2)
  saleValue             Decimal?  @map("sale_value") @db.Decimal(14, 2)
  saleDate              DateTime? @map("sale_date")
  customerId            String?   @map("customer_id")
  sellerId              String?   @map("seller_id")
  // Campos calculados (atualizados por service/domain)
  totalCosts            Decimal   @default(0) @map("total_costs") @db.Decimal(14, 2)
  commissionValue       Decimal   @default(0) @map("commission_value") @db.Decimal(14, 2)
  grossProfit           Decimal?  @map("gross_profit") @db.Decimal(14, 2)
  marginAmount          Decimal?  @map("margin_amount") @db.Decimal(14, 2)
  marginPercent         Decimal?  @map("margin_percent") @db.Decimal(8, 4)
  netResult             Decimal?  @map("net_result") @db.Decimal(14, 2)
  daysInStock           Int?      @map("days_in_stock")
  calculatedAt          DateTime? @map("calculated_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  seller   User?     @relation("VehicleFinancialSeller", fields: [sellerId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, saleDate])
  @@index([tenantId, sellerId, saleDate])
  @@map("vehicle_financials")
}

// =============================================================================
// CUSTOS POR VEÍCULO
// =============================================================================

model VehicleCost {
  id            String          @id @default(uuid())
  tenantId      String          @map("tenant_id")
  vehicleId     String          @map("vehicle_id")
  type          VehicleCostType
  description   String
  amount        Decimal         @db.Decimal(14, 2)
  costDate      DateTime        @map("cost_date")
  supplierId    String?         @map("supplier_id")
  responsibleId String?         @map("responsible_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  createdById   String?         @map("created_by_id")
  updatedById   String?         @map("updated_by_id")

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  responsible User?     @relation("VehicleCostResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)
  createdBy   User?     @relation("VehicleCostCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, vehicleId])
  @@index([tenantId, costDate])
  @@index([tenantId, vehicleId, costDate])
  @@map("vehicle_costs")
}

// =============================================================================
// ESTOQUE — Movimentações
// =============================================================================

model StockMovement {
  id          String            @id @default(uuid())
  tenantId    String            @map("tenant_id")
  vehicleId   String            @map("vehicle_id")
  type        StockMovementType
  description String?
  reference   String? // NF, contrato, etc.
  userId      String?           @map("user_id")
  createdAt   DateTime          @default(now()) @map("created_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, vehicleId, createdAt])
  @@map("stock_movements")
}

// =============================================================================
// CLIENTES
// =============================================================================

model Customer {
  id               String       @id @default(uuid())
  tenantId         String       @map("tenant_id")
  name             String
  document         String // CPF ou CNPJ
  phone            String?
  email            String?
  street           String?
  number           String?
  complement       String?
  neighborhood     String?
  city             String?
  state            String?
  zipCode          String?      @map("zip_code")
  personType       PersonType   @map("person_type")
  customerType     CustomerType @default(BUYER) @map("customer_type")
  notes            String?
  assignedSellerId String?      @map("assigned_seller_id")
  active           Boolean      @default(true)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  createdById      String?      @map("created_by_id")
  updatedById      String?      @map("updated_by_id")

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedSeller User?  @relation("CustomerAssignedSeller", fields: [assignedSellerId], references: [id], onDelete: SetNull)

  sales         Sale[]
  opportunities Opportunity[]
  leads         Lead[]
  financials    VehicleFinancial[]
  history       CustomerHistory[]

  @@unique([tenantId, document])
  @@index([tenantId, name])
  @@map("customers")
}

model CustomerHistory {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  customerId String   @map("customer_id")
  action     String // ex: CREATED, UPDATED, SALE, NOTE
  details    Json?
  userId     String?  @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, customerId, createdAt])
  @@map("customer_history")
}

// =============================================================================
// FORNECEDORES
// =============================================================================

model Supplier {
  id           String           @id @default(uuid())
  tenantId     String           @map("tenant_id")
  name         String
  document     String
  phone        String?
  email        String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  zipCode      String?          @map("zip_code")
  personType   PersonType       @map("person_type")
  category     SupplierCategory
  notes        String?
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")
  createdById  String?          @map("created_by_id")
  updatedById  String?          @map("updated_by_id")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  vehicleFinancials VehicleFinancial[]
  vehicleCosts      VehicleCost[]
  history           SupplierHistory[]

  @@unique([tenantId, document])
  @@index([tenantId, name])
  @@map("suppliers")
}

model SupplierHistory {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  supplierId String   @map("supplier_id")
  action     String
  details    Json?
  userId     String?  @map("user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([tenantId, supplierId, createdAt])
  @@map("supplier_history")
}

// =============================================================================
// VENDAS & OPORTUNIDADES
// =============================================================================

model Sale {
  id            String        @id @default(uuid())
  tenantId      String        @map("tenant_id")
  vehicleId     String        @map("vehicle_id")
  customerId    String        @map("customer_id")
  sellerId      String        @map("seller_id")
  amount        Decimal       @db.Decimal(14, 2)
  paymentMethod PaymentMethod @map("payment_method")
  saleDate      DateTime      @map("sale_date")
  status        SaleStatus    @default(NEGOTIATION)
  commission    Decimal?      @db.Decimal(14, 2)
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  createdById   String?       @map("created_by_id")
  updatedById   String?       @map("updated_by_id")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle  Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  seller   User     @relation("SaleSeller", fields: [sellerId], references: [id], onDelete: Restrict)

  @@index([tenantId, saleDate])
  @@index([tenantId, sellerId])
  @@index([tenantId, status])
  @@index([tenantId, status, saleDate])
  @@index([tenantId, sellerId, saleDate])
  @@map("sales")
}

model Opportunity {
  id          String            @id @default(uuid())
  tenantId    String            @map("tenant_id")
  vehicleId   String?           @map("vehicle_id")
  customerId  String            @map("customer_id")
  sellerId    String            @map("seller_id")
  title       String
  amount      Decimal?          @db.Decimal(14, 2)
  status      OpportunityStatus @default(OPEN)
  notes       String?
  nextFollowUpAt DateTime?      @map("next_follow_up_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicle  Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  seller   User     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  reminders SellerReminder[]

  @@index([tenantId, sellerId, status])
  @@map("opportunities")
}

// =============================================================================
// CRM COMERCIAL — leads, interesse, contatos e lembretes
// =============================================================================

model Lead {
  id               String     @id @default(uuid())
  tenantId         String     @map("tenant_id")
  name             String
  phone            String?
  email            String?
  source           LeadSource @default(OTHER)
  status           LeadStatus @default(NEW)
  sellerId         String?    @map("seller_id")
  customerId       String?    @map("customer_id")
  expectedAmount   Decimal?   @map("expected_amount") @db.Decimal(14, 2)
  notes            String?
  nextFollowUpAt   DateTime?  @map("next_follow_up_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  createdById      String?    @map("created_by_id")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  seller   User?     @relation("LeadAssignedSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  contacts LeadContact[]
  interests LeadVehicleInterest[]
  reminders SellerReminder[]

  @@index([tenantId, status])
  @@index([tenantId, sellerId, status])
  @@index([tenantId, nextFollowUpAt])
  @@map("leads")
}

model LeadVehicleInterest {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  leadId    String   @map("lead_id")
  vehicleId String   @map("vehicle_id")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  lead    Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([leadId, vehicleId])
  @@index([tenantId, vehicleId])
  @@map("lead_vehicle_interests")
}

model LeadContact {
  id          String         @id @default(uuid())
  tenantId    String         @map("tenant_id")
  leadId      String         @map("lead_id")
  channel     ContactChannel @default(OTHER)
  summary     String
  contactedAt DateTime       @map("contacted_at")
  userId      String?        @map("user_id")
  metadata    Json?
  createdAt   DateTime       @default(now()) @map("created_at")

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, leadId, contactedAt])
  @@map("lead_contacts")
}

model SellerReminder {
  id              String         @id @default(uuid())
  tenantId        String         @map("tenant_id")
  userId          String         @map("user_id")
  title           String
  description     String?
  dueAt           DateTime       @map("due_at")
  status          ReminderStatus @default(PENDING)
  leadId          String?        @map("lead_id")
  opportunityId   String?        @map("opportunity_id")
  vehicleId       String?        @map("vehicle_id")
  autoGenerated   Boolean        @default(false) @map("auto_generated")
  completedAt     DateTime?      @map("completed_at")
  createdAt       DateTime       @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, status, dueAt])
  @@map("seller_reminders")
}

// =============================================================================
// COMISSÕES
// =============================================================================

model CommissionRule {
  id        String             @id @default(uuid())
  tenantId  String             @map("tenant_id")
  name      String
  type      CommissionRuleType
  value     Decimal            @db.Decimal(14, 4) // % ou valor fixo conforme type
  active    Boolean            @default(true)
  isDefault Boolean            @default(false) @map("is_default")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
  @@map("commission_rules")
}

/// Regra de comissão padrão por vendedor
model SellerCommissionRule {
  id        String             @id @default(uuid())
  tenantId  String             @map("tenant_id")
  sellerId  String             @unique @map("seller_id")
  type      CommissionRuleType
  value     Decimal            @default(0) @db.Decimal(14, 4)
  active    Boolean            @default(true)
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  seller User   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
  @@map("seller_commission_rules")
}

/// Override de comissão para um veículo específico
model VehicleCommissionOverride {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  vehicleId String   @map("vehicle_id")
  type      CommissionRuleType
  value     Decimal  @db.Decimal(14, 4)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, vehicleId])
  @@map("vehicle_commission_overrides")
}

// =============================================================================
// CONFIGURAÇÕES DO TENANT
