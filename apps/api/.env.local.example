# Cópia: Copy-Item .env.local.example .env.local
# Uso: npm run start:dev  (ENV_PROFILE=local, padrão)

NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000

# PostgreSQL local (Docker ou instalado)
DATABASE_URL="postgresql://wps_car:wps_car_secret@localhost:5432/wps_car?schema=public"
DIRECT_DATABASE_URL="postgresql://wps_car:wps_car_secret@localhost:5432/wps_car?schema=public"

JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Import de veículos (API local)
IMPORT_API_URL=http://localhost:3001/api/v1

# Cache distribuído (opcional). Ex.: redis://localhost:6379
# REDIS_URL=

# Retenção de arquivos de export (dias). Padrão: 7
# EXPORT_RETENTION_DAYS=7

# Precificação inteligente — portais reais (http) ou mock local
# MARKET_LISTINGS_PROVIDER=mock
# MARKET_LISTINGS_HTTP_URL=https://sua-api.com/market?brand={brand}&model={model}&year={year}
# MARKET_LISTINGS_HTTP_URLS=[{"name":"WebMotors","url":"https://..."},{"name":"OLX","url":"https://..."}]
# MARKET_LISTINGS_HTTP_API_KEY=
# MARKET_LISTINGS_HTTP_HEADERS={"Authorization":"Bearer token"}
# MARKET_LISTINGS_HTTP_TIMEOUT_MS=8000
# MARKET_LISTINGS_HTTP_MIN_SUCCESS=1
